{
  "name": "effect-gh-docs",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "blume dev",
    "start": "blume dev",
    "build": "blume build --strict",
    "check": "blume check --strict",
    "lint": "oxlint -c oxlint.docs.config.ts .",
    "validate": "blume validate --strict",
    "deploy": "wrangler deploy --config dist/server/wrangler.json",
    "deploy:preview": "wrangler versions upload --config dist/server/wrangler.json",
    "preview": "blume preview",
    "brand": "bun scripts/brand-images.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.8",
    "@timmo001/docs-kit": "0.51.0",
    "blume": "2.2.7",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.93.0",
    "@timmo001/oxlint-rules": "0.7.1",
    "@types/bun": "1.4.4",
    "astro": "7.4.12",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "wrangler": "4.162.0"
  },
  "trustedDependencies": [
    "esbuild",
    "sharp"
  ]
}
