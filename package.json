{
  "name": "@timmo001/effect-gh",
  "version": "0.0.0",
  "private": true,
  "description": "An Effect v4 SDK for the GitHub CLI",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timmo001/effect-gh.git"
  },
  "scripts": {
    "build": "tsc",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "effect-tsgo patch"
  },
  "peerDependencies": {
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@effect/tsgo": "0.44.0",
    "@oxlint/plugins": "1.81.0",
    "@timmo001/oxlint-rules": "0.3.0",
    "effect": "4.0.0-rc.112",
    "oxlint": "1.81.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  },
  "trustedDependencies": [
    "@effect/tsgo"
  ]
}
