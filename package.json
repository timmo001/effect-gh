{
  "name": "@timmo001/effect-gh",
  "version": "0.2.0",
  "description": "An Effect v4 SDK for the GitHub CLI",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "bun@1.4.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timmo001/effect-gh.git"
  },
  "scripts": {
    "build": "tsc",
    "check": "bun run lint && bun run typecheck && bun run format:check && bun run test",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "bun test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "effect-tsgo patch --force=false",
    "prepack": "bun run build"
  },
  "peerDependencies": {
    "effect": "4.0.0-rc.118"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.0-rc.118",
    "@effect/tsgo": "0.47.0",
    "@oxlint/plugins": "1.86.0",
    "@timmo001/oxlint-rules": "0.4.0",
    "@types/bun": "1.4.2",
    "effect": "4.0.0-rc.118",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "prettier": "3.9.9",
    "typescript": "7.0.2"
  },
  "trustedDependencies": [
    "@effect/tsgo"
  ]
}
