{
  "name": "@timmo001/effect-gh",
  "version": "0.8.0",
  "description": "An Effect v4 SDK for the GitHub CLI",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "bun@1.4.4",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timmo001/effect-gh.git"
  },
  "scripts": {
    "build": "tsc",
    "check": "bun run --parallel --no-exit-on-error lint typecheck format:check test",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "bun test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "effect-tsgo patch --force=false",
    "prepack": "bun run build"
  },
  "peerDependencies": {
    "effect": "4.0.7"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.7",
    "@effect/tsgo": "0.62.0",
    "@oxlint/plugins": "1.90.0",
    "@timmo001/oxlint-rules": "0.6.3",
    "@types/bun": "1.4.4",
    "effect": "4.0.7",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  },
  "trustedDependencies": [
    "@effect/tsgo"
  ],
  "dependencies": {
    "graphql": "17.0.2"
  }
}
